CompileFlags:
  Add:
    - -isystemC:\Users\RedMi\.eide\tools\sdcc\include
    - -isystemC:\Users\RedMi\.eide\tools\sdcc\include\mcs51
    - -D__SDCC=1
    - -D__SDCC_VERSION_MAJOR=4
    - -D__SDCC_VERSION_MINOR=2
    - -D__SDCC_VERSION_PATCH=0
    - -D__SDCC_mcs51=1
    - -ferror-limit=0
  Remove:
    - --cpu
    - --li
    - --c99
    - --split_sections
    - --diag_suppress=*
    - --no_depend_system_headers
    - --depend
    - --strict
    - --enum_is_int
    - --gnu
    - --apcs=*
    - --signed_chars
    - --split_ldm
    - --execute_only
    - -Otime
  CompilationDatabase: ./build/Debug
Diagnostics:
  Suppress: "*"
